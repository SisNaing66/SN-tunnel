<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Mode Theme Configuration -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">#38BDF8</item>
        <item name="colorPrimaryVariant">#0284C7</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        
        <!-- Light Background & Surface Colors -->
        <item name="android:colorBackground">#F1F5F9</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnBackground">#0F172A</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="android:statusBarColor">#F1F5F9</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Light Custom Dialog Style -->
    <style name="DarkCustomDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_rounded_bg</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="colorAccent">#38BDF8</item>
        <item name="colorPrimary">#38BDF8</item>
    </style>
</resources>
